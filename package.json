{
  "name": "ftbquests-editor",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Visual, lossless two-way editor for FTB Quests SNBT files inside Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "dev:vault": "node esbuild.config.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MinestarUA/Obsidian-plugin-FTBQ.git"
  },
  "license": "MIT",
  "author": "ProstoMaslo"
}
